# Balej_Intelligence // Neural_GraphQL_Schema
scalar Upload
scalar DateTime
scalar Time

# --- IDENTITY_REALY --- #

input NewUser {
  id: ID!
  first_name: String!
  last_name: String!
  email: String!
  password: String!
  phone_number: String!
  address: String!
  role: String! # TALENT, CLIENT, ADMIN
}

input LoginInput {
  email: String!
  password: String!
}

input UpdateSettingsInput {
  email_notifications: Boolean
  two_factor_enabled: Boolean
  theme_accent: String
  hud_visibility: Boolean
}

type User {
  id: ID!
  first_name: String!
  last_name: String!
  email: String!
  phone_number: String!
  address: String!
  role: String!
  cv: String
  is_active: Boolean!
  is_verified: Boolean!
  two_factor_enabled: Boolean!
  theme_preference: String
  created_at: DateTime
}

type AuthPayload {
  token: String!
  user: User!
}

# --- JOB_INVENTORY --- #

input NewJobOffer {
  job_type: String! # Full-time, Contract, etc.
  title: String!
  description: String!
  location: String!
  offeredByuser: Int!
  category: String!
  salary_range: String
  experience_level: String
}

type JobOffer {
  job_id: ID!
  job_type: String!
  title: String!
  description: String!
  location: String!
  offeredByuser: User!
  category: String!
  applicationCount: Int!
  salary_range: String
  experience_level: String
  status: String! # LIVE, ARCHIVE, PENDING
  health_score: Int
  posted_at: DateTime
}

input JobFilter {
  job_offer_id: Int
  user_id: Int
  category: String
  status: String
}

# --- CANDIDACY_FLOW --- #

input JobApplication {
  jobApplicationId: Int!
  job_id: Int!
  userId: Int!
  proposal: String!
  cv: Upload!
}

type Applicants {
  userId: ID!
  job_id: Int!
  applied_at: DateTime!
  status: String! # PENDING, INTERVIEWING, HIRED, REJECTED
  resume: String!
  user: User
}

input JobApplicantFilter {
  job_offer_id: Int
  user_id: Int
  status: String
}

# --- COMMUNICATION_UPLINK --- #

type Message {
  id: ID!
  message: String!
  senderId: Int!
  chatID: String!
  sentAt: Time!
  is_read: Boolean!
}

type Chat {
  id: ID!
  participants: [User!]!
  last_message: Message
  updated_at: DateTime!
}

# --- MODERATION_PROTOCOLS --- #

type AuditLog {
  id: ID!
  action: String!
  performed_by: User!
  target_id: String
  timestamp: DateTime!
  metadata: String
}

type Flag {
  id: ID!
  target_type: String! # JOB, USER, MESSAGE
  target_id: ID!
  reason: String!
  status: String! # OPEN, RESOLVED, DISMISSED
  reported_by: User!
  created_at: DateTime!
}

# --- SYSTEM_RELAYS --- #

type Query {
  # User Queries
  users: [User!]!
  user(id: ID!): User
  me: User

  # Job Queries
  jobs: [JobOffer!]!
  jobsWithFilter(filter: JobFilter): [JobOffer!]!
  
  # Application Queries
  applicants: [Applicants!]!
  applicantsWithfilter(filter: JobApplicantFilter): [Applicants!]!

  # Chat Queries
  myChats: [Chat!]!
  chatHistory(chatID: ID!): [Message!]!

  # Moderation Queries (Admin Only)
  moderationQueue: [Flag!]!
  auditTrail: [AuditLog!]!
}

type Mutation {
  # Auth Mutations
  createUser(input: NewUser!): User!
  LoginUser(input: LoginInput): AuthPayload!
  Register(input: NewUser!): User!
  VerifyEmail(token: String!): Boolean!
  Enable2FA: String! # Returns secret/QR link

  # Settings Mutations
  UpdateNeuralSettings(input: UpdateSettingsInput!): User!

  # Job Mutations
  AddJobOffer(input: NewJobOffer!): JobOffer!
  UpdateJobStatus(job_id: ID!, status: String!): JobOffer!
  DeleteJob(job_id: ID!): Boolean!

  # Application Mutations
  ApplyToJob(input: JobApplication!): ApplicationResponse!
  ApproveApplication(job_id: Int!, userId: Int!): ApprovalResponse!
  RejectApplication(job_id: Int!, userId: Int!): RejectionResponse!

  # Communication Mutations
  SendMessage(chatID: String!, content: String!, senderId: Int!, recieverId: Int!): Message!
  CreateChat(participantId: Int!): Chat!

  # Moderation Mutations
  FlagTarget(target_type: String!, target_id: ID!, reason: String!): Flag!
  ResolveFlag(flag_id: ID!, action: String!): Boolean!

  # Security Relay Mutations
  GenerateSecureJobLink(job_id: ID!): String!
  VerifySecureJobLink(token: String!): JobOffer!
}

type Subscription {
  messageSent(chatID: ID!): Message!
  newNotification: String!
}

# --- RESPONSES --- #

type ApplicationResponse {
  response: String!
  user: User!
}

type ApprovalResponse {
  response: String!
}

type RejectionResponse {
  response: String!
}
